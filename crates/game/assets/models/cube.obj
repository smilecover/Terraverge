# 教程 viking_room.obj 的替代模型：一个带 UV 的立方体。
# 每个面使用完整的 0..1 纹理坐标，面按逆时针绕序定义（外法线朝外）。
# 加载器会按 (位置索引, UV 索引) 去重顶点，所以同一角点在不同面上是不同顶点。

v -0.5 -0.5 0.5
v 0.5 -0.5 0.5
v 0.5 0.5 0.5
v -0.5 0.5 0.5
v 0.5 -0.5 -0.5
v -0.5 -0.5 -0.5
v -0.5 0.5 -0.5
v 0.5 0.5 -0.5

vt 0 0
vt 1 0
vt 1 1
vt 0 1

# 前面 (+Z)
f 1/1 2/2 3/3 4/4
# 后面 (-Z)
f 5/1 6/2 7/3 8/4
# 左面 (-X)
f 6/1 1/2 4/3 7/4
# 右面 (+X)
f 2/1 5/2 8/3 3/4
# 顶面 (+Y)
f 4/1 3/2 8/3 7/4
# 底面 (-Y)
f 6/1 5/2 2/3 1/4
